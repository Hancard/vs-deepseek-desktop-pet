{
  "name": "vscode-anime-assistent",
  "displayName": "airi-monitor",
  "description": "Anime desktop pet for VS Code — tsundere Airi watches your code and roasts your bugs",
  "version": "0.3.17",
  "publisher": "123457890wasd-cmyk",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hancard/vs-deepseek-desktop-pet.git"
  },
  "engines": {
    "vscode": "^1.83.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vscode-anime-assistent.openAssistant",
        "title": "Open Anime Assistant"
      },
      {
        "command": "vscode-anime-assistent.launchPet",
        "title": "Launch Airi Desktop Pet"
      }
    ],
    "configuration": {
      "title": "Airi Monitor",
      "properties": {
        "airiMonitor.fileScan.enabled": {
          "type": "boolean",
          "default": true,
          "description": "桌宠主动监视当前打开文件的 bug：变化立刻播报，未变化定期提醒，修到 0 说一次\"干净了\"后沉默"
        },
        "airiMonitor.fileScan.repeatIntervalSec": {
          "type": "number",
          "default": 60,
          "minimum": 10,
          "description": "当前文件 bug 数量未变化时的重复提醒间隔（秒，最小 10）"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.83.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
